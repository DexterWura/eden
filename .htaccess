<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If already under /core/public/, stop
    RewriteCond %{REQUEST_URI} ^/core/public/ [NC]
    RewriteRule ^ - [L]

    # Serve existing files in core/public/ (CSS, JS, images) – clean URLs
    RewriteCond %{DOCUMENT_ROOT}/core/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ core/public/$1 [L]

    # Everything else: root index.php (boots Laravel from core/)
    RewriteRule ^(.*)$ index.php [L]
</IfModule>
